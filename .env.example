# ReturnLens settings. Copy this file to .env and fill in your keys. Never commit .env (it is in .gitignore).

# Google Gemini (free key): aistudio.google.com -> Get API key
# Without it the app still works, using keyword rules only.
GEMINI_API_KEY=
# Model for the AI step. Empty = gemini-3.5-flash-lite (free tier, fast).
# Other free-tier Flash models: gemini-3.6-flash, gemini-3.8-flash (each has its own daily limit).
GEMINI_MODEL=

# --- Optional: fetch reviews from a product link (Apify). Leave empty to use CSV upload only. ---
# apify.com -> Settings -> API & Integrations   (also: pip install apify-client)
APIFY_API_TOKEN=
# Review scraper actors. Empty = axesso_data/amazon-reviews-scraper / khadinakbar/flipkart-reviews-scraper
APIFY_AMAZON_ACTOR=
APIFY_FLIPKART_ACTOR=
# 1 = don't call Apify: use the newest saved response in data/raw/ or built-in fake reviews.
MOCK_FETCH=

# Optional settings
# GEMINI_FREE_TIER=1            # 0 = you are on the paid tier: the run log then shows real cost
# GEMINI_PRICE_INPUT_PER_M=0.30 # paid-tier USD per 1M input tokens (gemini-3.5-flash-lite)
# GEMINI_PRICE_OUTPUT_PER_M=2.50
# USD_TO_INR=88
